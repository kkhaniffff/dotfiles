#!/bin/sh

action=$(printf '%s\n' Lock Poweroff Reboot Suspend Logout | menu -p "Select action:")

[ -z "$action" ] && exit

confirm=$(printf '%s\n' Yes No | menu -p "Confirm $action?")

if [ "$confirm" = "Yes" ]; then
	case "$action" in
		Lock) playerctl pause; swaylock -f ;;
		Poweroff) systemctl poweroff ;;
		Reboot) systemctl reboot ;;
		Suspend) systemctl suspend ;;
		Logout) swaymsg exit ;;
	esac
fi
